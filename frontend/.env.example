# =============================================================================
# ScoutPilot AI — Frontend / Vercel Environment Configuration
# =============================================================================

# (Optional) SerpApi API Key for serverless execution on Vercel
# If omitted, ScoutPilot runs in Preview Demo Mode with verified benchmark fixtures.
# Evaluators can also input their SerpApi key dynamically in the UI Settings modal.
SERPAPI_API_KEY=your_serpapi_key_here

# (Optional) External FastAPI backend URL (e.g. if running FastAPI on Render/Railway)
# If omitted or left empty, Next.js routes handle requests directly via Vercel serverless.
# BACKEND_URL=https://your-backend.onrender.com

# (Optional) Public API URL if pointing client-side fetch directly to an external backend
# NEXT_PUBLIC_API_URL=https://your-backend.onrender.com

# (Optional) Application canonical URL for OpenGraph metadata and social sharing cards
NEXT_PUBLIC_APP_URL=https://your-project.vercel.app
