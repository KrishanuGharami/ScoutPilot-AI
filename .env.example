# =============================================================================
# ScoutPilot AI — Backend Environment Configuration Template
# SerpApi India Hackathon 2026 (AI Agents Track)
# =============================================================================

# Copy this file to backend/.env. The frontend must never receive this key.
# Your SerpApi API Key (required for live searches)
# Get a free key with 250 monthly searches at https://serpapi.com/users/sign_up
SERPAPI_API_KEY=your_serpapi_api_key_here

# Timeout in seconds for external SerpApi search queries
SERPAPI_TIMEOUT=15

# Default geographic parameters for localized search in India
DEFAULT_LOCATION=India
DEFAULT_GL=in
DEFAULT_HL=en

# Application environment
APP_ENV=development
